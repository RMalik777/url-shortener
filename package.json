{
	"name": "monorepo-url-shortener",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "turbo run dev --filter=web",
		"dev:server": "turbo run dev --filter=server",
		"build": "turbo run build",
		"preview": "turbo run preview",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"check-types": "turbo run check-types",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "prettier --check . && turbo run lint check-types test",
		"clean": "turbo run clean",
		"cf-typegen": "turbo run cf-typegen",
		"deploy": "turbo run deploy",
		"deploy:web": "turbo run deploy --filter=web",
		"deploy:server": "turbo run deploy --filter=server",
		"auth:generate": "pnpm --filter web auth:generate",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:pull": "turbo run db:pull",
		"db:check": "turbo run db:check",
		"db:studio": "turbo run db:studio"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "catalog:",
		"turbo": "^2.11.10"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	}
}

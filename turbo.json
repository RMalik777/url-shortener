{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.bench.ts", "!README.md"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["transit"]
		},
		"lint": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.gitignore"]
		},
		"lint:fix": {
			"dependsOn": ["transit"],
			"cache": false
		},
		"test": {
			"dependsOn": ["transit"],
			"outputs": []
		},
		"bench": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"preview": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false,
			"passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
		},
		"cf-typegen": {
			"inputs": ["wrangler.jsonc", ".env*", ".dev.vars*"],
			"outputs": ["worker-configuration.d.ts"]
		},
		"clean": {
			"cache": false
		},
		"db:generate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"db:migrate": {
			"cache": false,
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"db:pull": {
			"cache": false,
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"db:check": {
			"cache": false,
			"passThroughEnv": ["CLOUDFLARE_*"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["CLOUDFLARE_*"]
		}
	}
}

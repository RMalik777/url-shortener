{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"check-types": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run --passWithNoTests",
		"clean": "rimraf dist .turbo",
		"bench": "vitest bench --config vitest.config.bench.ts",
		"auth:generate": "pnpm dlx @better-auth/cli@latest generate --config ./src/lib/auth/index.ts --output ../../packages/db/src/auth-schema.generated.ts -y && prettier --write ../../packages/db/src/auth-schema.generated.ts"
	},
